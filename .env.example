# Translation model. Point at a local vLLM server (recommended) or a
# Hugging Face repo id / local checkpoint for in-process loading.
TRANSLATION_MODEL_ID=
VLLM_BASE_URL=
VLLM_MODEL=

# Streaming ASR for the web demo's audio input. Points at a separately
# deployed Confucius4-R2T2 WebSocket service. Leave empty to skip audio;
# the text-debug panel still works.
ASR_WS_URL=
ASR_SECRET_KEY=test0102

# Everything else (device, dtype, timeouts, buffer sizes, host/port, ...)
# has a working default in inference/config.py. Override here only if you
# need to change it.
